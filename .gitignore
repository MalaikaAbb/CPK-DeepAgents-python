# Secrets
.env
.env.local
.env.*.local
!.env.example

# Node
node_modules/
.next/
out/
next-env.d.ts
*.tsbuildinfo

# Python
.venv/
__pycache__/
*.py[cod]

# LangGraph dev server state
.langgraph_api/

# CopilotKit CLI project metadata (contains project ids)
.copilotkit/

# Editor / OS
.DS_Store
*.log

# Drift reports are derived data — regenerated on every /doc-sync run.
# The snapshot itself (doc-snapshot/pages/, manifest.json, CHANGELOG.md)
# IS committed; it is the baseline every diff is taken against.
doc-snapshot/reports/

# Autorecorder output. Recordings are build artifacts, reproducible via
# `npm run record`; see autorecorder/videos/.gitignore for why committing them
# is a mistake worth not repeating (17 clips at ~5MB, rewritten on every
# re-record, took a sibling repo's .git to 348MB).
autorecorder/videos/*.webm
autorecorder/videos/.temp_chunks/

# Hand-recorded takes. Same reasoning, bigger files -- these are screen
# captures rather than Playwright output, and the folder is currently 421MB.
# The rules above only cover .webm at the top level, so a `git add -A` was one
# keystroke away from committing all of it.
autorecorder/videos/manuall/

# Per-run recorder output and logs, regenerated on every run.
autorecorder/videos/RUN_REPORT.md
autorecorder/videos/RUN_REPORT.json
autorecorder/videos/RECORD_RESULTS*.json
autorecorder/videos/DOCUMENTED_REPORT.md
autorecorder/videos/logs/

# Generated by autorecorder/scripts/write-versions.mjs (run by `npm run doctor`).
# Describes one machine's resolved dependency tree, so committing it would
# immediately be a lie.
frontend/VERSIONS.md

# The previous tester's handover: QA report and Loom recordings, kept locally
# for context while the recorder is built against them. Not ours to publish,
# and to be deleted once the takes reproduce what it describes.
previous-testingoutcomes/
